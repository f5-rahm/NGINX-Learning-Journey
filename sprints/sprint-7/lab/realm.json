{
  "realm": "tidewater",
  "displayName": "Tidewater Logistics",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "groups": [ { "name": "staff" }, { "name": "admins" } ],
  "users": [
    { "username": "alice", "enabled": true, "email": "alice@tidewater.example", "emailVerified": true,
      "firstName": "Alice", "lastName": "Admin",
      "credentials": [ { "type": "password", "value": "alice-pass", "temporary": false } ],
      "groups": [ "/staff", "/admins" ] },
    { "username": "bob", "enabled": true, "email": "bob@tidewater.example", "emailVerified": true,
      "firstName": "Bob", "lastName": "Dispatcher",
      "credentials": [ { "type": "password", "value": "bob-pass", "temporary": false } ],
      "groups": [ "/staff" ] }
  ],
  "clients": [
    { "clientId": "portal", "name": "Staff portal (OAuth2 Proxy)", "enabled": true, "protocol": "openid-connect",
      "publicClient": false, "secret": "portal-lab-secret",
      "standardFlowEnabled": true, "directAccessGrantsEnabled": false,
      "redirectUris": [ "https://localhost:8091/oauth2/callback" ],
      "webOrigins": [ "+" ],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "https://localhost:8091/*" },
      "protocolMappers": [
        { "name": "groups", "protocol": "openid-connect", "protocolMapper": "oidc-group-membership-mapper",
          "config": { "claim.name": "groups", "full.path": "false", "id.token.claim": "true",
                      "access.token.claim": "true", "userinfo.token.claim": "true" } }
      ] },
    { "clientId": "plus-portal", "name": "Staff portal (NGINX Plus OIDC, side quest)", "enabled": true,
      "protocol": "openid-connect", "publicClient": false, "secret": "plus-lab-secret",
      "standardFlowEnabled": true, "directAccessGrantsEnabled": false,
      "redirectUris": [ "https://localhost:8094/oidc_callback" ],
      "webOrigins": [ "+" ],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "https://localhost:8094/*" },
      "protocolMappers": [
        { "name": "groups", "protocol": "openid-connect", "protocolMapper": "oidc-group-membership-mapper",
          "config": { "claim.name": "groups", "full.path": "false", "id.token.claim": "true",
                      "access.token.claim": "true", "userinfo.token.claim": "true" } }
      ] },
    { "clientId": "dispatch-cli", "name": "Dispatch command-line tool (side quest bearer tokens)", "enabled": true,
      "protocol": "openid-connect", "publicClient": true,
      "standardFlowEnabled": false, "directAccessGrantsEnabled": true,
      "protocolMappers": [
        { "name": "groups", "protocol": "openid-connect", "protocolMapper": "oidc-group-membership-mapper",
          "config": { "claim.name": "groups", "full.path": "false", "id.token.claim": "true",
                      "access.token.claim": "true", "userinfo.token.claim": "true" } },
        { "name": "aud-dispatch-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "dispatch-api", "id.token.claim": "false", "access.token.claim": "true" } }
      ] }
  ]
}
